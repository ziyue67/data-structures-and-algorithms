{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW g++ 16.2 (Debug)",
      "description": "MSYS2 UCRT64 工具链 + Ninja，输出在 build/mingw-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "D:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW g++ 16.2 (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "D:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC 14.51 (Visual Studio 2026)",
      "description": "Visual Studio 18 2026 生成器，多配置，输出在 build/msvc",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/msvc",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    }
  ],
  "workflowPresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug：配置 + 构建",
      "steps": [
        { "type": "configure", "name": "mingw-debug" },
        { "type": "build", "name": "mingw-debug" }
      ]
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW Release：配置 + 构建",
      "steps": [
        { "type": "configure", "name": "mingw-release" },
        { "type": "build", "name": "mingw-release" }
      ]
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug：配置 + 构建",
      "steps": [
        { "type": "configure", "name": "msvc" },
        { "type": "build", "name": "msvc-debug" }
      ]
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release：配置 + 构建",
      "steps": [
        { "type": "configure", "name": "msvc" },
        { "type": "build", "name": "msvc-release" }
      ]
    }
  ]
}
